{
  "name": "klosti",
  "version": "0.1.0",
  "description": "See every rule, skill, hook and MCP server your coding agents use, where each applies, and what contradicts.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "klosti": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
